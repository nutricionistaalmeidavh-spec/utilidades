  "entrypoint": "./src/index.mjs",
  "implementedCapabilities": ["capture-request-validation", "code-result-normalization", "scan-file-runtime-boundary", "opencv-mat-grayscale", "opencv-mat-threshold"],
  "plannedCapabilities": [],
