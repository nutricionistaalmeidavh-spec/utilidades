{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_EXISTING_WORKER_NAME",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artisys-qa",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "artisysqa"
    }
  ]
}
