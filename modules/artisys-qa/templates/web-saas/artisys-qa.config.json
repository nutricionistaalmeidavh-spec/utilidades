{
  "schemaVersion": 1,
  "systemId": "web-saas-example",
  "mode": "web",
  "defaultEnvironment": "local",
  "defaultFlow": "smoke",
  "defaultViewport": "desktop",
  "capture": {
    "video": true,
    "screenshotEachStep": true,
    "fps": 4
  },
  "environments": {
    "local": {
      "baseURL": "http://127.0.0.1:4173"
    },
    "production": {
      "baseURL": "https://example.com"
    }
  },
  "flows": {
    "smoke": "flows/00-smoke.json"
  },
  "qaProfiles": {
    "quick": {
      "flows": ["smoke"],
      "criticalFlows": ["smoke"],
      "includeVisual": false,
      "includeDesktop": false,
      "includeNetwork": false
    },
    "full": {
      "flows": ["smoke"],
      "criticalFlows": ["smoke"],
      "includeVisual": false,
      "includeDesktop": false,
      "includeNetwork": false
    },
    "release": {
      "flows": ["smoke"],
      "criticalFlows": ["smoke"],
      "includeVisual": false,
      "includeDesktop": false,
      "includeNetwork": false
    }
  }
}
