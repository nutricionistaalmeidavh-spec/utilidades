{
  "schemaVersion": 1,
  "id": "artisys-qa",
  "name": "ArtiSys QA",
  "version": "2.1.0",
  "status": "stable",
  "consumptionMode": "shared",
  "upstreams": ["playwright"],
  "boundary": "Reusable QA platform for web/Electron products with declarative flows, execution profiles, desktop smoke checks, network/concurrency helpers, reusable business packs, evidence capture, reports/history, fail-closed release gates, optional self-hosted Remote Control, and an optional Windows local agent with logon startup and stable A/B auto-update. Product-specific persistence, schema mapping, credentials, selectors and installer behavior remain isolated behind consumer configuration/adapters.",
  "provides": [
    "shared-playwright-config",
    "declarative-flow-runner",
    "quick-full-release-profiles",
    "desktop-executable-smoke-kit",
    "network-recovery-helpers",
    "isolated-browser-terminals",
    "auth-commerce-finance-workforce-packs",
    "unified-json-html-report",
    "bounded-local-history",
    "fail-closed-release-gate",
    "declarative-demo-runner",
    "demo-profile-manager",
    "fixture-registry",
    "reusable-flow-library",
    "adapter-capabilities",
    "secret-redaction",
    "web-chromium-capture",
    "electron-window-capture",
    "screenshots",
    "opt-in-visual-regression",
    "video",
    "playwright-trace",
    "console-network-telemetry",
    "desktop-tablet-mobile-viewports",
    "consumer-process-lifecycle",
    "optional-self-hosted-remote-control",
    "token-authenticated-remote-runner",
    "mobile-remote-dashboard",
    "remote-profile-selection",
    "remote-history-view",
    "optional-windows-local-agent",
    "windows-logon-autostart",
    "agent-project-registry",
    "stable-channel-auto-update",
    "ab-slot-update",
    "automatic-health-rollback",
    "github-composite-action",
    "github-reusable-workflow",
    "consumer-template",
    "pos-reference-example"
  ],
  "packageName": "@artisys/qa",
  "entrypoint": "./src/index.js",
  "implementedCapabilities": [
    "manifest-contract",
    "flow-selection",
    "qa-profile-resolution",
    "qa-profile-orchestration",
    "desktop-process-startup-shutdown",
    "desktop-premature-exit-detection",
    "network-transient-retry",
    "concurrent-terminal-helper",
    "business-pack-resolution",
    "report-json",
    "report-html",
    "report-history",
    "release-gate-critical-failures",
    "release-gate-audited-override",
    "agent-state-registry",
    "agent-project-register-unregister",
    "agent-supervised-remote-runners",
    "agent-stable-version-check",
    "agent-inactive-slot-validation",
    "agent-active-slot-switch",
    "agent-startup-health-check",
    "agent-automatic-rollback",
    "agent-autoupdate-toggle",
    "agent-task-scheduler-install",
    "demo-selection",
    "demo-profile-selection",
    "demo-profile-prepare-reset-status",
    "built-in-fixture-packs",
    "consumer-fixture-packs",
    "flow-composition-uses",
    "adapter-capability-steps",
    "recursive-secret-redaction",
    "environment-selection",
    "viewport-selection",
    "secret-from-environment",
    "web-video-webm",
    "electron-video-mp4-via-ffmpeg",
    "step-screenshots",
    "failure-screenshot",
    "visual-snapshot-step",
    "visual-baseline-update",
    "visual-pixel-diff-artifacts",
    "trace-zip",
    "telemetry-json",
    "run-summary-json",
    "demo-summary-json",
    "remote-control-dashboard",
    "remote-control-token-auth",
    "remote-control-manifest-whitelist",
    "remote-control-profile-whitelist",
    "remote-control-single-run-lock",
    "remote-control-history",
    "github-artifact-upload"
  ],
  "plannedCapabilities": [],
  "verification": {
    "unit": "npm test",
    "browser": "npm run test:example",
    "manifest": "npm run check",
    "package": "npm pack --dry-run"
  },
  "compatibility": {
    "node": ">=22",
    "playwright": ">=1.51 <2",
    "windowsAgent": "Windows 10/11 + Git + PowerShell 5.1+",
    "githubRunner": "ubuntu-latest",
    "electron": "consumer-provided",
    "ffmpeg": "required-for-demo-mp4-and-electron-video",
    "ffprobe": "required-for-demo-duration-normalization"
  },
  "limitations": [
    "Product-specific persistence, fixture schema mapping, UI capabilities and installer behavior are implemented by each consumer adapter/configuration.",
    "Desktop smoke checks require the executable to exist on the runner operating system.",
    "Persistent demo accounts require a consumer environment/backend that persists between runs; local Electron consumers can use snapshot strategy.",
    "Private repository auto-update requires Git authentication already configured on the Windows machine; the agent does not store a GitHub token.",
    "Visual regression is disabled by default and only runs with --visual or ARTISYS_QA_VISUAL=1.",
    "Remote Control exposes only manifest-defined flow/profile/environment/viewport choices and does not accept arbitrary shell commands.",
    "Direct phone access is intended for a trusted LAN; internet exposure requires a separately configured secure VPN/reverse proxy and is not a core dependency.",
    "The runner machine must remain powered on for Remote Control and agent executions.",
    "Local-only systems require a compatible local runner for OS-specific executable and installer checks."
  ],
  "costPolicy": {
    "coreLicenseFee": 0,
    "selfHosted": true,
    "requiredPaidServices": []
  }
}
