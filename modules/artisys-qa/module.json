{
  "schemaVersion": 1,
  "id": "artisys-qa",
  "name": "ArtiSys QA",
  "version": "1.3.0",
  "status": "stable",
  "consumptionMode": "shared",
  "upstreams": ["playwright"],
  "boundary": "Reusable QA and demo platform: browser/Electron automation, demo-profile lifecycle, fixture orchestration, reusable flow composition, opt-in visual regression and evidence capture. Product-specific account/workspace persistence, schema mapping, credentials and selectors remain isolated behind the consumer adapter.",
  "provides": [
    "shared-playwright-config",
    "declarative-flow-runner",
    "declarative-demo-runner",
    "demo-profile-manager",
    "persistent-demo-account-lifecycle",
    "demo-workspace-strategies",
    "fixture-registry",
    "versioned-demo-fixtures",
    "reusable-flow-library",
    "adapter-capabilities",
    "secret-redaction",
    "web-chromium-capture",
    "electron-window-capture",
    "screenshots",
    "opt-in-visual-regression",
    "local-screenshot-baselines",
    "visual-expected-actual-diff",
    "video",
    "playwright-trace",
    "console-network-telemetry",
    "desktop-tablet-mobile-viewports",
    "social-video-presets",
    "reels-9x16-output",
    "square-1x1-output",
    "landscape-16x9-output",
    "consumer-process-lifecycle",
    "isolated-browser-terminals",
    "product-login-fixture",
    "http-readiness-check",
    "github-composite-action",
    "github-reusable-workflow",
    "consumer-template",
    "pos-reference-example"
  ],
  "packageName": "@artisys/qa",
  "entrypoint": "./src/index.js",
  "implementedCapabilities": [
    "manifest-contract",
    "flow-selection",
    "demo-selection",
    "demo-profile-selection",
    "demo-profile-prepare-reset-status",
    "demo-account-find-create-reuse",
    "persistent-snapshot-ephemeral-workspaces",
    "demo-workspace-reset-guard",
    "built-in-fixture-packs",
    "consumer-fixture-packs",
    "fixture-revisions",
    "flow-composition-uses",
    "adapter-capability-steps",
    "recursive-secret-redaction",
    "demo-duration-target",
    "demo-media-duration-normalization",
    "demo-step-hold",
    "environment-selection",
    "viewport-selection",
    "secret-from-environment",
    "web-video-webm",
    "electron-video-mp4-via-ffmpeg",
    "social-video-normalization",
    "reels-1080x1920-mp4",
    "square-1080x1080-mp4",
    "landscape-1920x1080-mp4",
    "step-screenshots",
    "failure-screenshot",
    "visual-snapshot-step",
    "visual-baseline-update",
    "visual-pixel-diff-artifacts",
    "trace-zip",
    "telemetry-json",
    "run-summary-json",
    "demo-summary-json",
    "github-artifact-upload"
  ],
  "plannedCapabilities": [],
  "verification": {
    "unit": "npm test",
    "browser": "npm run test:example",
    "manifest": "npm run check"
  },
  "compatibility": {
    "node": ">=22",
    "playwright": ">=1.51 <2",
    "githubRunner": "ubuntu-latest",
    "electron": "consumer-provided",
    "ffmpeg": "required-for-demo-mp4-and-electron-video",
    "ffprobe": "required-for-demo-duration-normalization"
  },
  "limitations": [
    "Product-specific account/workspace persistence, fixture schema mapping and UI capabilities are implemented by each consumer adapter.",
    "Persistent demo accounts require a consumer environment/backend that persists between runs; local Electron consumers can use snapshot strategy.",
    "Private cross-repository GitHub Action use requires GitHub Actions access to utilidades or a pinned runtime copy.",
    "Electron demo capture keeps a desktop viewport and pads/scales into the requested social canvas instead of squeezing the UI.",
    "Demo videos do not add music, narration, captions or editorial motion.",
    "Visual regression is disabled by default and only runs with --visual or ARTISYS_QA_VISUAL=1.",
    "Local-only systems require Electron launch in Actions or a reachable test environment."
  ],
  "costPolicy": {
    "coreLicenseFee": 0,
    "selfHosted": true,
    "requiredPaidServices": []
  }
}
