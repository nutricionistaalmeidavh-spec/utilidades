{
  "schemaVersion": 1,
  "id": "artisys-release",
  "name": "ArtiSys Release",
  "version": "0.1.0",
  "status": "implemented",
  "consumptionMode": "shared",
  "executionMode": "local-or-ci",
  "upstreams": ["playwright", "gitleaks", "trivy", "semgrep", "pact-js", "openapi-generator", "cosign"],
  "boundary": "Provider-neutral release pipeline. Product commands are injected by configuration; CI providers only invoke the same engine.",
  "provides": ["release-plan", "sequential-gates", "artifact-sha256", "blocking-summary", "pipeline-profiles", "command-runner", "json-report", "cli"],
  "packageName": "@artisys/release",
  "entrypoint": "./src/index.mjs",
  "implementedCapabilities": ["release-plan", "sequential-gates", "artifact-sha256", "blocking-summary", "quick-full-release-profiles", "installer-before-qa", "fail-fast-command-pipeline", "required-step-policy", "dry-run", "json-report", "cli"],
  "plannedCapabilities": ["artifact-manifest-signing", "parallel-non-release-checks"],
  "verification": {"unit": "npm test", "syntax": "npm run check", "example": "npm run example", "package": "npm pack --dry-run", "dryRun": "npm run dry-run"},
  "limitations": ["Product-specific build, installer, QA, deploy and publish commands remain owned by the consumer.", "Woodpecker server/agent credentials are infrastructure configuration and are not stored in this module."],
  "costPolicy": {"coreLicenseFee": 0, "selfHosted": true, "requiredPaidServices": []}
}
