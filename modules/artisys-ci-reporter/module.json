{
  "schemaVersion": 1,
  "id": "artisys-ci-reporter",
  "name": "ArtiSys CI Reporter",
  "version": "0.1.0",
  "status": "implemented",
  "consumptionMode": "shared",
  "executionMode": "local-or-ci",
  "upstreams": [],
