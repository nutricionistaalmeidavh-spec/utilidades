  "entrypoint": "./src/index.mjs",
  "implementedCapabilities": [
    "woodpecker-failure-summary",
    "github-commit-status",
    "github-commit-comment",
    "optional-pr-comment",
    "clone-independent-fallback"
  ],
  "plannedCapabilities": [],
  "verification": {
