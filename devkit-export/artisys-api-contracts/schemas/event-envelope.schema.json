{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artisys.local/schemas/event-envelope.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "occurredAt", "source", "correlationId", "payload"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
