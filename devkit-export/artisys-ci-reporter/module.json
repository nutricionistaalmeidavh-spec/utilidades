{
  "schemaVersion": 1,
  "id": "artisys-ci-reporter",
  "name": "ArtiSys CI Reporter",
  "version": "0.3.0",
  "status": "implemented",
  "consumptionMode": "shared",
  "executionMode": "local-or-ci",
  "upstreams": [],
  "boundary": "Reusable CI success/failure diagnostics and GitHub reporting for ArtiSys products.",
  "provides": [
    "woodpecker-failure-summary",
    "woodpecker-success-summary",
    "release-gate-summary",
    "structured-qa-failure-summary",
    "github-commit-status",
    "github-commit-comment",
    "optional-pr-comment",
    "clone-independent-fallback"
  ],
  "packageName": "@artisys/ci-reporter",
  "entrypoint": "./src/index.mjs",
  "implementedCapabilities": [
    "product-generic-diagnostics",
    "success-and-failure-status",
    "release-gate-summary",
    "structured-qa-failure-summary",
    "qa-failed-flow-and-step-reporting",
    "qa-evidence-path-reporting",
    "github-commit-status",
    "github-commit-comment",
    "optional-pr-comment",
    "clone-independent-fallback",
    "windows-powershell-log-normalization"
  ],
  "plannedCapabilities": [],
  "verification": {
    "unit": "npm test",
    "syntax": "npm run check"
  },
  "limitations": [
    "Requires a GitHub token supplied by the CI host environment.",
    "Detailed release-step diagnostics depend on an artisys-release report or captured log; otherwise it reports clone-or-workflow fallback context.",
    "Structured QA detail requires the product pipeline to publish artifacts/qa-summary.json or set ARTISYS_QA_REPORT_PATH."
  ],
  "costPolicy": {
    "coreLicenseFee": 0,
    "selfHosted": true,
    "requiredPaidServices": []
  }
}
